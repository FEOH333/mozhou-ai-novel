# 墨舟密钥环境变量模板（V0.109.1）
#
# 用法：把下面两行填好，在启动墨舟之前导入当前环境变量即可。
#   Git Bash :  cp secrets.env.example secrets.env && 编辑 && source secrets.env
#   PowerShell: 见 README「用环境变量管理密钥」一节
#   Windows 持久化: setx NOVEL_API_KEY "sk-xxxx"（重开终端生效）
#
# 设了环境变量后，data/config.json 里对应的 apiKey 会被环境变量覆盖，
# 并且**绝不会被回写磁盘**——即使你在设置页点了「保存」，落盘的仍是磁盘原值。
# 也就是说：密钥只存在于环境变量里，配置文件里永远是空的。
#
# secrets.env / .env / .env.* 均已在 .gitignore 中排除，不会被提交。

# 主端点密钥（阿里云 MaaS / DeepSeek / 任意 OpenAI 兼容端点）
export NOVEL_API_KEY=""

# 备用端点密钥（不启用备用通道可留空）
export NOVEL_BACKUP_API_KEY=""
